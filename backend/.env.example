# PIN de acceso al módulo de inventario (cámbialo antes de producción)
ADMIN_PIN=1234

# RUT del restaurante (sin puntos, con guión y DV)
# Ejemplo: 76123456-7
RESTAURANTE_RUT=76123456-7

# Integración SII (opcional - requiere certificado digital)
# Dejar vacío para usar modo verificación manual
SII_CERT_PEM_PATH=
SII_KEY_PEM_PATH=

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Base de datos (SQLite por defecto)
DATABASE_URL=sqlite:///./inventario.db
